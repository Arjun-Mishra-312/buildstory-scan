{
  "name": "@buildstory/scanner",
  "version": "0.3.0",
  "private": true,
  "description": "BuildStory read-only local scanner for privacy-preserving AI-assisted project snapshots.",
  "type": "module",
  "bin": {
    "buildstory": "dist/src/cli.js",
    "story-scanner": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema": "./schema/project-snapshot.schema.json"
  },
  "files": [
    "dist/src",
    "schema",
    "examples",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run test:built",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test \"dist/test/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-name-pattern=\"validated one-PUT upload\" \"dist/test/cli.test.js\"",
    "buildstory": "node dist/src/cli.js",
    "scan": "node dist/src/cli.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
