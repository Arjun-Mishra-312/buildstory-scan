{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-scanner.local/schemas/project-snapshot-1.7.0.json",
  "title": "ProjectSnapshot",
  "description": "Privacy-preserving aggregate of repository and AI coding-session activity. Transcript bodies, tool payloads, paths, diffs, and source text are intentionally not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scanId",
    "generatedAt",
    "sourceSelection",
    "repository",
    "timeWindow",
    "sessions",
    "usage",
    "git",
    "milestones",
    "evidence",
    "redaction",
    "provenance",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": "1.7.0" },
    "scanId": { "type": "string", "pattern": "^scan_[a-f0-9]{24}$" },
    "generatedAt": { "$ref": "#/$defs/dateTime" },
    "sourceSelection": { "$ref": "#/$defs/sourceSelection" },
    "repository": { "$ref": "#/$defs/repository" },
    "timeWindow": { "$ref": "#/$defs/timeWindow" },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    },
    "usage": { "$ref": "#/$defs/usage" },
    "git": { "$ref": "#/$defs/git" },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "redaction": { "$ref": "#/$defs/redaction" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "quality": { "$ref": "#/$defs/quality" },
    "narrativeEvidence": { "$ref": "#/$defs/narrativeEvidence" },
    "generatedNarrative": { "$ref": "#/$defs/generatedNarrative" }
  },
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers", "consent"],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "selected", "repositoryScoped", "rootsConsidered", "filesDiscovered", "sessionsMatched", "sessionsIncluded"],
            "properties": {
              "provider": { "enum": ["codex", "claude-code", "gemini-antigravity", "cursor"] },
              "selected": { "const": true },
              "repositoryScoped": { "const": true },
              "rootsConsidered": { "$ref": "#/$defs/nonNegativeInteger" },
              "filesDiscovered": { "$ref": "#/$defs/nonNegativeInteger" },
              "sessionsMatched": { "$ref": "#/$defs/nonNegativeInteger" },
              "sessionsIncluded": { "$ref": "#/$defs/nonNegativeInteger" },
              "warnings": { "$ref": "#/$defs/nonNegativeInteger" },
              "diagnostic": { "enum": ["not-installed", "no-project-directory", "no-matching-sessions", "format-unsupported", "scope-unknown", "scanned"] }
            }
          }
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "statementVersion", "approvedActions", "deniedActions"],
          "properties": {
            "mode": { "const": "explicit-cli" },
            "statementVersion": { "const": "1.0" },
            "approvedActions": {
              "type": "array",
              "prefixItems": [
                { "const": "read-repository-metadata" },
                { "const": "read-selected-local-session-metadata" },
                { "const": "write-local-snapshot" }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "deniedActions": {
              "type": "array",
              "prefixItems": [{ "const": "network-upload" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "fingerprintBasis", "displayName", "vcs", "rootPathIncluded", "headCommit", "branch", "detachedHead", "remote", "bare"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "fingerprintBasis": { "enum": ["canonical-remote", "local-path"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "vcs": { "const": "git" },
        "rootPathIncluded": { "const": false },
        "headCommit": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
            { "type": "null" }
          ]
        },
        "branch": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "detachedHead": { "type": "boolean" },
        "remote": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repositoryPathHash"],
              "properties": {
                "repositoryPathHash": { "$ref": "#/$defs/sha256" }
              }
            },
            { "type": "null" }
          ]
        },
        "bare": { "type": "boolean" }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone", "startBasis", "endBasis"],
      "properties": {
        "start": { "$ref": "#/$defs/dateTime" },
        "end": { "$ref": "#/$defs/dateTime" },
        "timezone": { "const": "UTC" },
        "startBasis": { "enum": ["explicit", "full-history", "default-lookback", "empty-repository"] },
        "endBasis": { "enum": ["explicit", "latest-session", "head-commit", "unix-epoch"] },
        "utcOffsetMinutes": { "type": "integer", "minimum": -840, "maximum": 840 }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "cachedInputTokens", "outputTokens", "reasoningOutputTokens", "totalTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cachedInputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "reasoningOutputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "totalTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheCreationInputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheCreation1hInputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheCreation5mInputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheReadInputTokens": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionRef", "provider", "sourceKind", "startedAt", "endedAt", "status", "workingDirectoryRelation", "summary", "turns", "assistantMessages", "toolCalls", "modelRefs", "toolRefs", "tokenUsage"],
      "properties": {
        "sessionRef": { "type": "string", "pattern": "^ses_[a-f0-9]{20}$" },
        "provider": { "enum": ["codex", "claude-code", "gemini-antigravity", "cursor"] },
        "sourceKind": { "enum": ["active", "archived", "custom"] },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "endedAt": { "$ref": "#/$defs/dateTime" },
        "status": { "enum": ["completed", "aborted", "incomplete", "unknown"] },
        "workingDirectoryRelation": { "enum": ["repository-root", "subdirectory"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "turns": { "$ref": "#/$defs/nonNegativeInteger" },
        "assistantMessages": { "$ref": "#/$defs/nonNegativeInteger" },
        "toolCalls": { "$ref": "#/$defs/nonNegativeInteger" },
        "modelRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "toolRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "tokenUsage": {
          "anyOf": [
            { "$ref": "#/$defs/tokenUsage" },
            { "type": "null" }
          ]
        },
        "planModeTurns": { "$ref": "#/$defs/nonNegativeInteger" },
        "subagentInvocations": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "models", "totalToolCalls", "totalTurns", "tokenUsage"],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "callCount", "sessionCount"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "callCount": { "$ref": "#/$defs/nonNegativeInteger" },
              "sessionCount": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "name", "turnCount", "sessionCount"],
            "properties": {
              "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "turnCount": { "$ref": "#/$defs/nonNegativeInteger" },
              "sessionCount": { "$ref": "#/$defs/nonNegativeInteger" },
              "tokenUsage": {
                "anyOf": [
                  { "$ref": "#/$defs/tokenUsage" },
                  { "type": "null" }
                ]
              },
              "costMicroUsd": {
                "anyOf": [
                  { "$ref": "#/$defs/nonNegativeInteger" },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "totalToolCalls": { "$ref": "#/$defs/nonNegativeInteger" },
        "totalTurns": { "$ref": "#/$defs/nonNegativeInteger" },
        "tokenUsage": {
          "anyOf": [
            { "$ref": "#/$defs/tokenUsage" },
            { "type": "null" }
          ]
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalMicroUsd", "pricedTokens", "unpricedTokens", "pricingTableVersion"],
          "properties": {
            "totalMicroUsd": {
              "anyOf": [
                { "$ref": "#/$defs/nonNegativeInteger" },
                { "type": "null" }
              ]
            },
            "pricedTokens": { "$ref": "#/$defs/nonNegativeInteger" },
            "unpricedTokens": { "$ref": "#/$defs/nonNegativeInteger" },
            "pricingTableVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionsDiscovered", "sessionsIncluded", "sessionsSkipped", "skipped", "partiallyPricedModels"],
          "properties": {
            "sessionsDiscovered": { "$ref": "#/$defs/nonNegativeInteger" },
            "sessionsIncluded": { "$ref": "#/$defs/nonNegativeInteger" },
            "sessionsSkipped": { "$ref": "#/$defs/nonNegativeInteger" },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reason", "count"],
                "properties": {
                  "reason": {
                    "enum": ["outside-window", "no-timestamp", "duplicate-session-id", "parse-failed", "file-unreadable"]
                  },
                  "count": { "$ref": "#/$defs/nonNegativeInteger" }
                }
              }
            },
            "partiallyPricedModels": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "mergeCommits", "contributors", "fileTouches", "insertions", "deletions", "workingTree"],
      "properties": {
        "commits": { "$ref": "#/$defs/nonNegativeInteger" },
        "mergeCommits": { "$ref": "#/$defs/nonNegativeInteger" },
        "contributors": { "$ref": "#/$defs/nonNegativeInteger" },
        "fileTouches": { "$ref": "#/$defs/nonNegativeInteger" },
        "insertions": { "$ref": "#/$defs/nonNegativeInteger" },
        "deletions": { "$ref": "#/$defs/nonNegativeInteger" },
        "workingTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isDirty", "stagedEntries", "modifiedEntries", "untrackedEntries", "conflictedEntries"],
          "properties": {
            "isDirty": { "type": "boolean" },
            "stagedEntries": { "$ref": "#/$defs/nonNegativeInteger" },
            "modifiedEntries": { "$ref": "#/$defs/nonNegativeInteger" },
            "untrackedEntries": { "$ref": "#/$defs/nonNegativeInteger" },
            "conflictedEntries": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestoneId", "kind", "title", "summary", "occurredAt", "evidenceRefs"],
      "properties": {
        "milestoneId": { "type": "string", "pattern": "^mil_[a-f0-9]{20}$" },
        "kind": { "enum": ["session-activity", "repository-activity"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "occurredAt": { "$ref": "#/$defs/dateTime" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ev_[a-f0-9]{20}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "source", "kind", "observedAt", "digest"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^ev_[a-f0-9]{20}$" },
        "source": { "enum": ["codex", "claude-code", "gemini-antigravity", "cursor", "git"] },
        "kind": { "enum": ["session-boundary", "tool-activity", "git-aggregate"] },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "digest": { "$ref": "#/$defs/sha256" },
        "sessionRef": { "type": "string", "pattern": "^ses_[a-f0-9]{20}$" },
        "eventOrdinal": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "redactionCategory": {
      "enum": ["private-key", "anthropic-key", "aws-access-key", "github-token", "gitlab-token", "slack-token", "stripe-key", "twilio-key", "openai-key", "huggingface-token", "npm-token", "pypi-token", "google-api-key", "oauth-token", "azure-storage-key", "cloudflare-token", "jwt", "authorization", "credential-url", "sensitive-assignment", "high-entropy", "control-character"]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "findings", "categories", "metadataValuesScanned", "metadataValuesTruncated", "transcriptBodiesDiscarded", "toolPayloadsDiscarded", "finalLeakCheckPassed", "limitations"],
      "properties": {
        "applied": { "const": true },
        "findings": { "$ref": "#/$defs/nonNegativeInteger" },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "count"],
            "properties": {
              "category": { "$ref": "#/$defs/redactionCategory" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "metadataValuesScanned": { "$ref": "#/$defs/nonNegativeInteger" },
        "metadataValuesTruncated": { "$ref": "#/$defs/nonNegativeInteger" },
        "transcriptBodiesDiscarded": { "$ref": "#/$defs/nonNegativeInteger" },
        "toolPayloadsDiscarded": { "$ref": "#/$defs/nonNegativeInteger" },
        "finalLeakCheckPassed": { "const": true },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "collectionMode", "sessionFormats", "deterministicSerialization", "repositoryCommands", "sourceFilesConsidered", "sourceFilesParsed", "sourceFilesSkipped"],
      "properties": {
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "enum": ["buildstory", "story-scanner"] },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
          }
        },
        "collectionMode": { "const": "local-read-only" },
        "sessionFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["codex-jsonl", "claude-code-jsonl", "gemini-antigravity-jsonl", "cursor-sqlite"] }
        },
        "deterministicSerialization": { "const": "lexicographic-json" },
        "repositoryCommands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["git-config", "git-log-shortstat", "git-rev-list", "git-rev-parse", "git-show", "git-status"] }
        },
        "sourceFilesConsidered": { "$ref": "#/$defs/nonNegativeInteger" },
        "sourceFilesParsed": { "$ref": "#/$defs/nonNegativeInteger" },
        "sourceFilesSkipped": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "enum": ["CODEX_ROOT_UNAVAILABLE", "CLAUDE_CODE_ROOT_UNAVAILABLE", "GEMINI_ANTIGRAVITY_ROOT_UNAVAILABLE", "CURSOR_ROOT_UNAVAILABLE", "PROVIDER_FORMAT_UNVERIFIED", "PROVIDER_SCOPE_UNKNOWN", "SESSION_FILE_LIMIT_REACHED", "SESSION_FILE_TOO_LARGE", "SESSION_LINE_TOO_LARGE", "SESSION_LINE_INVALID_JSON", "SESSION_MISSING_METADATA", "SESSION_TIMESTAMP_INVALID", "SESSION_MODEL_UNKNOWN", "SESSION_ACTIVE_AT_SCAN_END", "GIT_HISTORY_UNAVAILABLE", "GIT_STATUS_UNAVAILABLE", "NO_MATCHING_SESSIONS"] },
        "severity": { "enum": ["info", "warning"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sessionRef": { "type": "string", "pattern": "^ses_[a-f0-9]{20}$" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "warningCount", "warnings", "assumptions"],
      "properties": {
        "level": { "enum": ["high", "medium", "low"] },
        "warningCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "generatedNarrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "mode", "provider", "model", "sections", "fallbacksUsed"],
      "properties": {
        "version": { "enum": ["1.0.0", "2.0.0"] },
        "generatedAt": { "$ref": "#/$defs/dateTime" },
        "mode": { "const": "local" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "narrative", "turningPoint", "learnings", "decisionPatterns", "standoutTraits", "growthEdge"],
          "properties": {
            "headline": { "type": "string", "minLength": 1, "maxLength": 160 },
            "narrative": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "turningPoint": { "type": "string", "minLength": 1, "maxLength": 400 },
            "learnings": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "decisionPatterns": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "standoutTraits": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "growthEdge": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "storyPack": { "$ref": "#/$defs/storyPack" },
        "fallbacksUsed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
      }
    },
    "storyPackSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "provider", "occurredAt", "evidenceRefs", "metrics"],
      "properties": {
        "ref": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" },
        "provider": { "enum": ["codex", "claude-code", "cursor", "gemini-antigravity", "git"] },
        "sessionRef": { "type": "string", "pattern": "^ses_[a-f0-9]{20}$" },
        "occurredAt": { "$ref": "#/$defs/dateTime" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^ev_[a-f0-9]{20}$" } },
        "excerptRef": { "type": "string", "pattern": "^exc_[a-f0-9]{20}$" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turns", "assistantMessages", "toolCalls"],
          "properties": {
            "turns": { "$ref": "#/$defs/nonNegativeInteger" },
            "assistantMessages": { "$ref": "#/$defs/nonNegativeInteger" },
            "toolCalls": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      }
    },
    "storyPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sources", "hero", "buildArc", "moments", "turningPoint", "decisions", "learnings", "standoutTraits", "growthEdge"],
      "properties": {
        "version": { "const": "2.0.0" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/storyPackSource" } },
        "hero": {
          "type": "object", "additionalProperties": false, "required": ["headline", "summary"],
          "properties": { "headline": { "type": "string", "minLength": 1, "maxLength": 120 }, "summary": { "type": "string", "minLength": 1, "maxLength": 480 } }
        },
        "buildArc": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["phase", "headline", "summary", "sourceRefs"],
            "properties": {
              "phase": { "enum": ["discover", "decide", "deliver"] },
              "headline": { "type": "string", "minLength": 1, "maxLength": 100 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 260 },
              "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } }
            }
          }
        },
        "moments": {
          "type": "array", "minItems": 3, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["phase", "kind", "title", "whatHappened", "whyItMattered", "sourceRefs"],
            "properties": {
              "phase": { "enum": ["discover", "decide", "deliver"] },
              "kind": { "enum": ["discovery", "decision", "breakthrough", "delivery"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "whatHappened": { "type": "string", "minLength": 1, "maxLength": 400 },
              "whyItMattered": { "type": "string", "minLength": 1, "maxLength": 400 },
              "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } }
            }
          }
        },
        "turningPoint": {
          "type": "object", "additionalProperties": false, "required": ["quote", "sourceRefs"],
          "properties": { "quote": { "type": "string", "minLength": 1, "maxLength": 300 }, "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } } }
        },
        "decisions": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": { "type": "object", "additionalProperties": false, "required": ["title", "rationale", "outcome", "sourceRefs"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "rationale": { "type": "string", "minLength": 1, "maxLength": 300 }, "outcome": { "type": "string", "minLength": 1, "maxLength": 300 }, "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } } } }
        },
        "learnings": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": { "type": "object", "additionalProperties": false, "required": ["title", "detail", "sourceRefs"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "detail": { "type": "string", "minLength": 1, "maxLength": 300 }, "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } } } }
        },
        "standoutTraits": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": { "type": "object", "additionalProperties": false, "required": ["title", "detail", "sourceRefs"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "detail": { "type": "string", "minLength": 1, "maxLength": 300 }, "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } } } }
        },
        "growthEdge": {
          "type": "object", "additionalProperties": false, "required": ["title", "observation", "nextStep", "sourceRefs"],
          "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "observation": { "type": "string", "minLength": 1, "maxLength": 400 }, "nextStep": { "type": "string", "minLength": 1, "maxLength": 300 }, "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^(S[0-9]{2,}|GIT)$" } } }
        }
      }
    },
    "narrativeExcerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excerptId", "sessionRef", "occurredAt", "role", "text"],
      "properties": {
        "excerptId": { "type": "string", "pattern": "^exc_[a-f0-9]{20}$" },
        "sessionRef": { "type": "string", "pattern": "^ses_[a-f0-9]{20}$" },
        "occurredAt": { "$ref": "#/$defs/dateTime" },
        "role": { "enum": ["session-title", "user-intent", "plan-transition", "assistant-decision", "outcome"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    },
    "narrativeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleVersion", "generatedAt", "policy", "consent", "excerpts", "discarded"],
      "properties": {
        "bundleVersion": { "const": "1.0.0" },
        "generatedAt": { "$ref": "#/$defs/dateTime" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxExcerpts", "maxCharsPerExcerpt", "maxTotalChars", "excerptSelection"],
          "properties": {
            "maxExcerpts": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxCharsPerExcerpt": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxTotalChars": { "$ref": "#/$defs/nonNegativeInteger" },
            "excerptSelection": { "const": "deterministic-heuristic-v1" }
          }
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "statementVersion", "approvedActions"],
          "properties": {
            "mode": { "const": "explicit-cli-review" },
            "statementVersion": { "const": "1.0" },
            "approvedActions": {
              "type": "array",
              "prefixItems": [{ "const": "send-redacted-excerpts-to-configured-cloud-model" }],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "excerpts": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/narrativeExcerpt" }
        },
        "discarded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "rejectedByRedaction", "rejectedByBudget"],
          "properties": {
            "candidates": { "$ref": "#/$defs/nonNegativeInteger" },
            "rejectedByRedaction": { "$ref": "#/$defs/nonNegativeInteger" },
            "rejectedByBudget": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "emptyReason": { "enum": ["no-supported-provider-evidence", "no-candidates-in-window", "all-candidates-rejected"] }
      }
    }
  }
}
